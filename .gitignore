# --- Build (Gradle) ---
# 'build/' e '.gradle/' senza slash iniziale coprono ogni cartella con quel nome
# a qualunque profondita', quindi anche i build annidati dei moduli.
build/
.gradle/
out/
bin/
.kotlin/
tmp/

# --- Percorso SDK specifico della macchina ---
